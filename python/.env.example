# Talos AI — Environment Variables
# Copy to .env and fill in your values

# --- LLM Provider ---
LLM_PROVIDER=openrouter          # openrouter or bedrock
OPENROUTER_API_KEY=sk-or-...     # Get from https://openrouter.ai/keys
AWS_REGION=us-east-1             # For Bedrock

# --- Temporal ---
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# --- Procurement Platform ---
PROCUREMENT_PLATFORM=jaggaer     # jaggaer, sap_ariba, coupa, oracle_fusion, workday, gep_smart, etc.
PROCUREMENT_BASE_URL=https://your-instance.jaggaer.com
PROCUREMENT_API_KEY=
PROCUREMENT_CLIENT_ID=
PROCUREMENT_CLIENT_SECRET=
PROCUREMENT_TENANT_ID=
PROCUREMENT_ENV=production       # production or sandbox

# --- Client ---
CLIENT_MODE=university           # university, nypa, northwell
CLIENT_NAME=

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# --- Database ---
DATABASE_URL=

# --- Notifications ---
SLACK_WEBHOOK_URL=
SENDGRID_API_KEY=
EMAIL_FROM=procurement@talos.ai

# --- Logging ---
LOG_LEVEL=INFO
